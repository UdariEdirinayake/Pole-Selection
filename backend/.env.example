# =============================================================================
# LineDesign / Pole-Select Environment Configuration
# =============================================================================

# Shared Database Connection:
# To share a live database among collaborators, set DATABASE_URL to a shared
# PostgreSQL database instance (e.g. from Supabase, Neon, AWS RDS, or Render):
#
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
#
# If DATABASE_URL is left unset, the backend falls back to local SQLite:
# DATABASE_URL=sqlite:///./pole_select.db
